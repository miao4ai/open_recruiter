# LLM Provider: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Semantic search embeddings (Voyage AI).
# Without a key, search falls back to keyword-only matching.
VOYAGE_API_KEY=pa-...
# VOYAGE_MODEL=voyage-4-lite

# JWT signing key. Leave unset — a random per-install key is generated
# on first run and stored locally.
# JWT_SECRET=

# Email: "console" (default), "sendgrid", or "gmail"
EMAIL_BACKEND=console
# SENDGRID_API_KEY=SG....
# EMAIL_FROM=recruiter@yourcompany.com

# LangSmith tracing (dev only — see traces at https://smith.langchain.com)
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=open-recruiter
